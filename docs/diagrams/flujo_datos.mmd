%% Flujo de datos: subir Excel y obtener análisis
sequenceDiagram
    autonumber
    actor Analista
    participant Browser as Navegador
    participant Flask as Flask (Vercel)
    participant Excel as excel_import.py
    participant Stats as statistics/*
    participant DB as Supabase Postgres

    Analista->>Browser: Selecciona archivo .xlsx
    Browser->>Flask: POST /api/estudios/upload (multipart)
    Flask->>Excel: parse_excel(bytes)
    Excel-->>Flask: metadata + muestras
    Flask->>DB: INSERT estudios + muestras (JSONB)
    DB-->>Flask: estudio_id
    Flask-->>Browser: 201 { id, muestras, ok }
    Browser->>Browser: redirect /estudio/{id}
    Browser->>Flask: GET /estudio/{id} (HTML)
    Browser->>Flask: POST /api/analisis/grafico
    Flask->>Stats: x_bar_r_chart(subgrupos)
    Stats-->>Flask: chart + reglas Nelson
    Flask-->>Browser: JSON (puntos, LSC, LIC, violaciones)
    Browser->>Browser: Plotly.newPlot()
